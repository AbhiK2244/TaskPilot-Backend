# PostgreSQL example. Create a database named taskpilot first.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/taskpilot
# For a quick local SQLite run instead, use:
# DATABASE_URL=sqlite:///./taskpilot.db
AUTO_CREATE_TABLES=true

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
REMINDER_EMAIL=

TIMEZONE=Asia/Kolkata
